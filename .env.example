# ============================================================
# Hermes Agent — Environment Configuration
# Copy ke .env dan isi. File .env JANGAN di-commit.
# ============================================================

# --- Core ---
# Zona waktu untuk timestamp briefing
TZ=Asia/Jakarta
# Port FastAPI health endpoint
HERMES_PORT=8000
# Level log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Telegram (WAJIB) ---
# Token dari @BotFather
TELEGRAM_BOT_TOKEN=
# Chat ID tujuan briefing otomatis (startup). Dapatkan dari @userinfobot
# PENTING: ini Chat ID ANDA (user), BUKAN angka di depan TELEGRAM_BOT_TOKEN.
TELEGRAM_CHAT_ID=
# Allowlist chat yang boleh memakai bot (pisah koma). Default = TELEGRAM_CHAT_ID.
# WAJIB diisi untuk cloud/production. Harus sama dengan Chat ID pribadi Anda.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Security / cloud ---
# development | production
HERMES_ENV=production
# Nonaktifkan /docs /redoc /openapi.json (1=off)
HERMES_DISABLE_API_DOCS=1
# Opsional: token header X-Hermes-Health-Token untuk /health
HERMES_HEALTH_TOKEN=
# Office monitoring: Cloud accepts signed snapshots only through a reverse
# proxy that has verified the laptop relay mTLS certificate.
OFFICE_OBSERVER_ID=office-observer-1
OFFICE_OBSERVER_SHARED_SECRET=
OFFICE_OBSERVER_MTLS_SUBJECT=

# --- Google Gemini (WAJIB) ---
# API key dari https://aistudio.google.com
GEMINI_API_KEY=
# Model Gemini
GEMINI_MODEL=gemini-1.5-flash

# --- Web search ---
TAVILY_API_KEY=

# --- Gemini official quota (optional service account) ---
GEMINI_QUOTA_PROJECT_ID=
GEMINI_QUOTA_CREDENTIALS=/app/credentials/gemini-quota-service-account.json

# --- Finance spreadsheet / Realbyte manual import ---
# --- Money Manager spreadsheet ---
# Path default Docker: /app/data/reference/...
# Jika path itu tidak ada, Hermes otomatis fallback ke file di root repo
# (Kategori Money Manager.xlsx, MoneyManager-2025.xlsx).
# File rekomendasi lokal (hasil scripts/build_category_recommendations.py):
# config/category_recommendations.json
FINANCE_ACCOUNT=Cash
FINANCE_CATEGORY_REFERENCE=/app/data/reference/Kategori Money Manager.xlsx
FINANCE_HISTORY_WORKBOOK=/app/data/reference/MoneyManager-2025.xlsx
FINANCE_CATEGORY_RECOMMENDATIONS=/app/data/reference/category_recommendations.json
FINANCE_EXPORT_DIR=/app/data/finance
# Proven working import uses dd/MM/yyyy (e.g. 16/07/2026). Filename can be anything.
FINANCE_EXPORT_DATE_FORMAT=%d/%m/%Y

# --- Google OAuth (Gmail finance + Calendar Pribadi) ---
# Enable Gmail API + Google Calendar API on the OAuth client.
GOOGLE_CLIENT_SECRETS=/app/credentials/google_client_secret.json
GOOGLE_TOKEN_PATH=/app/credentials/google_token.json
GOOGLE_TOKEN_PATHS=/app/credentials/google_token.json,/app/credentials/google_token_2.json
GOOGLE_ACCOUNT_LABELS=Pribadi,Kerja
GOOGLE_CALENDAR_WRITE_ACCOUNT=Pribadi
GOOGLE_CALENDAR_WRITE=1

# --- Microsoft Outlook (Graph, read-only) ---
# Set to 1 only if Outlook agenda is required.
MS_OUTLOOK_ENABLED=0
# Dari Azure App Registration
MS_CLIENT_ID=
MS_TENANT_ID=common
# Path cache token MSAL
MS_TOKEN_CACHE=/app/credentials/ms_token_cache.json

# --- Persona ---
# Nama persona yang dipakai (lihat config/persona.py). Default: nyx
HERMES_PERSONA=nyx
# Panggilan Hermes kepada Anda (mis. Tuan, Tuanku, Ksatria, atau nama Anda)
HERMES_ADDRESS=Tuan
# Path file persona custom (opsional, override persona bawaan). Kosongkan jika tak dipakai.
HERMES_PERSONA_FILE=

# --- Finance intake (Gmail scan + paste/upload dual mode via /import) ---
# Legacy filters (unused by import session; kept for optional tooling):
FINANCE_EMAIL_SENDERS=
FINANCE_EMAIL_KEYWORDS=transaksi,pembayaran,pembelian,struk,invoice,receipt,payment,debit,kredit,top up,topup,transfer

# --- Database / State ---
# Path SQLite (taruh di data/ yang di-sync antar mesin)
HERMES_DB_PATH=/app/data/hermes.db

# --- Folder sync antar mesin (di-mount ke container) ---
# Arahkan ke folder OneDrive 'hermes-assistant' (berisi data/ + credentials/).
# BEDA path tiap mesin — set per-mesin, JANGAN di-commit.
#   Mac (laptop ini):
#     HERMES_SYNC_DIR=/Users/fachrifa/Library/CloudStorage/OneDrive-Personal/hermes-assistant
#   Windows (PC rumah), contoh:
#     HERMES_SYNC_DIR=C:/Users/<user>/OneDrive/hermes-assistant
HERMES_SYNC_DIR=/Users/fachrifa/Library/CloudStorage/OneDrive-Personal/hermes-assistant

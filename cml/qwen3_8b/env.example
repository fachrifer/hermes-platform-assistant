# CML project: qwen3_8b
# Runtime: PBJ Workbench | Python 3.12 | Nvidia GPU Edition (CUDA 12.5)

# App code root (dedicated project = /home/cdsw)
QWEN_APP_DIR=/home/cdsw

# --- Pilih SALAH SATU sumber model ---
# A) Hugging Face
QWEN_MODEL_ID=Qwen/Qwen3-8B
HF_TOKEN=

# B) Weights lokal
# QWEN_MODEL_PATH=/home/cdsw/models/Qwen3-8B

# Preload: on CML Application always prefer "background"
#   background = bind CDSW_APP_PORT first, then load weights (recommended)
#   1          = load before HTTP (CML often kills the engine during load)
#   0          = lazy load on first chat
QWEN_PRELOAD=background
# Reasoning/thinking OFF by default
QWEN_ENABLE_THINKING=0
QWEN_HOST=127.0.0.1

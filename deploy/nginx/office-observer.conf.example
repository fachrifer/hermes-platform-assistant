# Dedicated DNS name only for observer ingest, for example observer.hermes.example.com.
# Hermes itself remains bound to 127.0.0.1:8000 by docker-compose.cloud.yml.
server {
    listen 443 ssl;
    server_name observer.hermes.example.com;

    ssl_certificate /etc/nginx/certs/cloud-server.pem;
    ssl_certificate_key /etc/nginx/certs/cloud-server-key.pem;
    ssl_client_certificate /etc/nginx/certs/relay-ca.pem;
    ssl_verify_client on;

    location = /api/v1/office/snapshots {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Nginx overwrites this header after client-certificate verification.
        proxy_set_header X-Hermes-Observer-Subject $ssl_client_s_dn;
        proxy_set_header X-Hermes-Observer $http_x_hermes_observer;
        proxy_set_header X-Hermes-Signature $http_x_hermes_signature;
    }

    location / {
        return 404;
    }
}

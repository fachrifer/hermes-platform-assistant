# Runs on the laptop during office hours. Bind only to its office-LAN IP.
OFFICE_RELAY_BIND_ADDRESS=192.168.1.50
OFFICE_RELAY_PORT=8443
OFFICE_RELAY_TIMEZONE=Asia/Jakarta
OFFICE_RELAY_START=08:00
OFFICE_RELAY_END=18:00

# mTLS server for the office observer. This CA trusts observer client certificates only.
OFFICE_RELAY_TLS_CERT=/certs/relay-server.pem
OFFICE_RELAY_TLS_KEY=/certs/relay-server-key.pem
OFFICE_RELAY_CLIENT_CA_FILE=/certs/observer-ca.pem

# Outbound mTLS client to the dedicated cloud observer hostname.
HERMES_CLOUD_INGEST_URL=https://observer.hermes.example.com
HERMES_CLOUD_CA_FILE=/certs/cloud-ca.pem
HERMES_CLOUD_CLIENT_CERT=/certs/relay-client.pem
HERMES_CLOUD_CLIENT_KEY=/certs/relay-client-key.pem

# Host-only path used by docker-compose.relay.yml
OFFICE_RELAY_CERT_DIR=/opt/hermes-office-relay/certs

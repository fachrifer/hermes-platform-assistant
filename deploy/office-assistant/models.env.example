# Shared LiteLLM endpoint + model (gitignored as models.env).
# Docker cannot use the hostname litellm.lab unless that name resolves inside
# the containers. Do not set OPENAI_API_KEY here — per-agent virtual keys
# belong in hermes/<role>/.env. Compose loads this file first, then the role
# .env, so the role key wins. local-up.sh copies non-empty OPENAI_* values
# into every hermes/<role>/.env.
OPENAI_BASE_URL=
OPENAI_MODEL=

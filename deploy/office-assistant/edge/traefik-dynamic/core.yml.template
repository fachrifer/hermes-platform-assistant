# Template for Traefik core routers (Athena, Dashboard, fleet).
# Render with: scripts/render-traefik-core.sh (injects OFFICE_GATEWAY_TOKEN_SUPERVISOR).
# Do not put real tokens in git — core.yml is generated on the host.

http:
  middlewares:
    fleet-auth:
      headers:
        customRequestHeaders:
          Authorization: "Bearer __OFFICE_GATEWAY_TOKEN_SUPERVISOR__"
    fleet-rewrite:
      replacePathRegex:
        regex: "^/api/fleet/(.*)"
        replacement: "/v1/fleet/$1"
    dash-strip:
      stripPrefix:
        prefixes:
          - "/dash"
    dash-login-next:
      redirectRegex:
        regex: "^https://([^/]+)/login(?:\\?next=/?|\\?next=%2F)?$"
        replacement: "https://${1}/dash/login?next=/dash/"
        permanent: false
    village-off:
      redirectRegex:
        regex: "^https://([^/]+)/?$"
        replacement: "https://${1}/dash/"
        permanent: false
    https-redirect:
      redirectScheme:
        scheme: https
        permanent: false
__BOT_MIDDLEWARES__

  routers:
    fleet:
      rule: "PathPrefix(`/api/fleet`)"
      entryPoints: [websecure]
      tls: {}
      priority: 100
      middlewares: [fleet-auth, fleet-rewrite]
      service: office-gateway

    api:
      rule: "PathPrefix(`/api/`)"
      entryPoints: [websecure]
      tls: {}
      priority: 90
      service: hermes-agent

    # Dashboard chat WS is /api/ws (not under /dash/). Keep above edge-routes (priority 20).
    api-ws:
      rule: "PathPrefix(`/api/ws`)"
      entryPoints: [websecure]
      tls: {}
      priority: 110
      service: hermes-agent

    auth:
      rule: "PathPrefix(`/auth/`)"
      entryPoints: [websecure]
      tls: {}
      priority: 90
      service: hermes-agent

    fonts:
      rule: "PathPrefix(`/fonts/`)"
      entryPoints: [websecure]
      tls: {}
      priority: 90
      service: hermes-agent

    fonts-terminal:
      rule: "PathPrefix(`/fonts-terminal/`)"
      entryPoints: [websecure]
      tls: {}
      priority: 90
      service: hermes-agent

    assets:
      rule: "PathPrefix(`/assets/`)"
      entryPoints: [websecure]
      tls: {}
      priority: 90
      service: hermes-agent

    dashboard-plugins:
      rule: "PathPrefix(`/dashboard-plugins/`)"
      entryPoints: [websecure]
      tls: {}
      priority: 90
      service: hermes-agent

    login:
      rule: "Path(`/login`)"
      entryPoints: [websecure]
      tls: {}
      priority: 90
      middlewares: [dash-login-next]
      service: hermes-agent

    favicon:
      rule: "Path(`/favicon.ico`)"
      entryPoints: [websecure]
      tls: {}
      priority: 90
      service: hermes-agent

    dash:
      rule: "PathPrefix(`/dash/`)"
      entryPoints: [websecure]
      tls: {}
      priority: 80
      middlewares: [dash-strip]
      service: hermes-agent

    # Keep Athena/console on HTTPS. Specialist Bot Mode uses HTTP /bots/ so
    # Desktop does not hit ERR_CERT_AUTHORITY_INVALID / Nous OAuth. Desktop
    # Connection Bots use published IP:port (9121–9126), not this path.
    http-to-https:
      rule: "!PathPrefix(`/bots/`)"
      entryPoints: [web]
      priority: 1
      middlewares: [https-redirect]
      service: office-www
__BOT_ROUTERS__

    avatars:
      rule: "PathPrefix(`/avatars/`)"
      entryPoints: [websecure]
      tls: {}
      priority: 50
      service: office-www

    athena:
      rule: "PathPrefix(`/`)"
      entryPoints: [websecure]
      tls: {}
      priority: 1
      middlewares: [village-off]
      service: hermes-agent

  services:
    office-gateway:
      loadBalancer:
        servers:
          - url: "http://office-gateway:8080"
    hermes-agent:
      loadBalancer:
        servers:
          - url: "http://hermes-agent:9119"
__BOT_SERVICES__
    office-www:
      loadBalancer:
        servers:
          - url: "http://office-www:80"

tls:
  certificates:
    - certFile: /certs/tls.crt
      keyFile: /certs/tls.key

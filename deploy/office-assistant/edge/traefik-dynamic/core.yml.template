# Template for Traefik core routers (Athena, Dashboard, fleet).
# Entry points: websecure (:443) is the public front door and belongs to the AI platform
# (catch-all / -> aiplatform-dashboard, plus edge-routes). hermes (:9443) carries the Athena
# console, /approvals, /api/fleet and /bots/. web (:80) redirects to HTTPS except plain-HTTP /bots/.
# Render with: scripts/render-traefik-core.sh (injects the supervisor and approver gateway tokens).
# Do not put real tokens in git — core.yml is generated on the host.

http:
  middlewares:
    fleet-auth:
      headers:
        customRequestHeaders:
          Authorization: "Bearer __OFFICE_GATEWAY_TOKEN_SUPERVISOR__"
    fleet-rewrite:
      replacePathRegex:
        regex: "^/api/fleet/(.*)"
        replacement: "/v1/fleet/$1"
    dash-strip:
      stripPrefix:
        prefixes:
          - "/dash"
    dash-login-next:
      redirectRegex:
        regex: "^https://([^/]+)/login(?:\\?next=/?|\\?next=%2F)?$"
        replacement: "https://${1}/dash/login?next=/dash/"
        permanent: false
    village-off:
      redirectRegex:
        regex: "^https://([^/]+)/?$"
        replacement: "https://${1}/dash/"
        permanent: false
    https-redirect:
      redirectScheme:
        scheme: https
        permanent: false
    approver-auth:
      basicAuth:
        usersFile: /etc/traefik/approvers.htpasswd
        headerField: X-Approver
        removeHeader: true
        realm: "Hermes approvals"
    approver-token:
      headers:
        customRequestHeaders:
          Authorization: "Bearer __OFFICE_GATEWAY_TOKEN_APPROVER__"
    approvals-api-rewrite:
      replacePathRegex:
        regex: "^/approvals/api(.*)"
        replacement: "/v1/approvals$1"
__BOT_MIDDLEWARES__

  routers:
    # AI platform (Next.js, host :3001) owns / on the public HTTPS port. Priority 1 so every
    # path-scoped edge route (attu, toolbox, ...) still wins.
    aiplatform:
      rule: "PathPrefix(`/`)"
      entryPoints: [websecure]
      tls: {}
      priority: 1
      service: aiplatform

    fleet:
      rule: "PathPrefix(`/api/fleet`)"
      entryPoints: [hermes]
      tls: {}
      priority: 100
      middlewares: [fleet-auth, fleet-rewrite]
      service: office-gateway

    # Approvals: HTTPS only, basic auth; Traefik sets X-Approver to the login
    # name and injects the approver bearer (never held by any agent).
    approvals-api:
      rule: "PathPrefix(`/approvals/api`)"
      entryPoints: [hermes]
      tls: {}
      priority: 120
      middlewares: [approver-auth, approver-token, approvals-api-rewrite]
      service: office-gateway

    approvals-page:
      rule: "PathPrefix(`/approvals`)"
      entryPoints: [hermes]
      tls: {}
      priority: 115
      middlewares: [approver-auth]
      service: office-www

    api:
      rule: "PathPrefix(`/api/`)"
      entryPoints: [hermes]
      tls: {}
      priority: 90
      service: hermes-agent

    # Dashboard chat WS is /api/ws (not under /dash/). Keep above edge-routes (priority 20).
    api-ws:
      rule: "PathPrefix(`/api/ws`)"
      entryPoints: [hermes]
      tls: {}
      priority: 110
      service: hermes-agent

    auth:
      rule: "PathPrefix(`/auth/`)"
      entryPoints: [hermes]
      tls: {}
      priority: 90
      service: hermes-agent

    fonts:
      rule: "PathPrefix(`/fonts/`)"
      entryPoints: [hermes]
      tls: {}
      priority: 90
      service: hermes-agent

    fonts-terminal:
      rule: "PathPrefix(`/fonts-terminal/`)"
      entryPoints: [hermes]
      tls: {}
      priority: 90
      service: hermes-agent

    assets:
      rule: "PathPrefix(`/assets/`)"
      entryPoints: [hermes]
      tls: {}
      priority: 90
      service: hermes-agent

    dashboard-plugins:
      rule: "PathPrefix(`/dashboard-plugins/`)"
      entryPoints: [hermes]
      tls: {}
      priority: 90
      service: hermes-agent

    login:
      rule: "Path(`/login`)"
      entryPoints: [hermes]
      tls: {}
      priority: 90
      middlewares: [dash-login-next]
      service: hermes-agent

    favicon:
      rule: "Path(`/favicon.ico`)"
      entryPoints: [hermes]
      tls: {}
      priority: 90
      service: hermes-agent

    dash:
      rule: "PathPrefix(`/dash/`)"
      entryPoints: [hermes]
      tls: {}
      priority: 80
      middlewares: [dash-strip]
      service: hermes-agent

    # Keep Athena/console on HTTPS. Specialist Bot Mode uses HTTP /bots/ so
    # Desktop does not hit ERR_CERT_AUTHORITY_INVALID / Nous OAuth. Desktop
    # Connection Bots use published IP:port (9121–9126), not this path.
    http-to-https:
      rule: "!PathPrefix(`/bots/`)"
      entryPoints: [web]
      priority: 1
      middlewares: [https-redirect]
      service: office-www
__BOT_ROUTERS__

    avatars:
      rule: "PathPrefix(`/avatars/`)"
      entryPoints: [hermes]
      tls: {}
      priority: 50
      service: office-www

    athena:
      rule: "PathPrefix(`/`)"
      entryPoints: [hermes]
      tls: {}
      priority: 1
      middlewares: [village-off]
      service: hermes-agent

  services:
    aiplatform:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "http://host.docker.internal:3001"
    office-gateway:
      loadBalancer:
        servers:
          - url: "http://office-gateway:8080"
    hermes-agent:
      loadBalancer:
        servers:
          - url: "http://hermes-agent:9119"
__BOT_SERVICES__
    office-www:
      loadBalancer:
        servers:
          - url: "http://office-www:80"

tls:
  certificates:
    - certFile: /certs/tls.crt
      keyFile: /certs/tls.key

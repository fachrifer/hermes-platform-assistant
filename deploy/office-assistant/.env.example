# Docker Compose env for the office-assistant stack on the VM.
# Copy to:  /home/timai/hermes-assistant/.env
#
# This file is read by `docker compose --env-file .env`.
# Hermes itself also needs hermes/.env (see hermes/.env.example).
# Keep OFFICE_GATEWAY_TOKEN and OPENAI_API_KEY identical in both files.

# --- Air-gapped VM ---
OFFICE_VM_HOST=10.216.4.80
OFFICE_VM_USER=timai
OFFICE_VM_DIR=/home/timai/hermes-assistant

# --- Images (loaded on the VM; do not pull) ---
OFFICE_GATEWAY_IMAGE=hermes-office-gateway:1.0.0
HERMES_IMAGE=nousresearch/hermes-agent:latest
OFFICE_IMAGE_PLATFORM=linux/amd64

# --- Dashboard (compose injects BASIC_AUTH_* into the Hermes container) ---
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD_PUBLISH=10.216.4.80:9119
# External HTTP test URL (firewall-friendly). Proxies to the dashboard on :9119.
DASHBOARD_PROXY_IMAGE=nginx:1.27-alpine
HERMES_DASHBOARD_HTTP_PUBLISH=10.216.4.80:80
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=office-admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change-me-dashboard-password

# --- LiteLLM gateway (intranet) ---
# Hermes OpenAI client calls {LITELLM_BASE_URL}/chat/completions
# Confirm models: curl -sS http://10.216.221.100/llm/v1/models
OPENAI_API_KEY=sk-change-me
LITELLM_BASE_URL=http://10.216.221.100/llm/v1
LITELLM_MODEL=qwen3.5-fast

# --- office-gateway ---
# Same token as hermes/.env OFFICE_GATEWAY_TOKEN.
OFFICE_GATEWAY_TOKEN=change-me-gateway-token
OFFICE_SERVICE_URLS=litellm=http://10.216.221.100/llm/v1/models,agent-inference=http://host.docker.internal:8010/health,workflow=http://host.docker.internal:8001/health,dashboard=http://host.docker.internal:3001/,common-service-frontend=http://host.docker.internal:555/,milvus=http://host.docker.internal:9091/healthz,attu=http://host.docker.internal:8000/,qdrant=http://host.docker.internal:6333/readyz
OFFICE_WRITE_TARGETS=agent-inference:restart_service,workflow:restart_service,dashboard:restart_service,common-service-frontend:restart_service
OFFICE_SCALE_BOUNDS=
OFFICE_ADAPTER_ENDPOINTS=
OFFICE_ACTION_TTL_SECONDS=600
OFFICE_GATEWAY_DB_PATH=/var/lib/hermes-office-gateway/gateway.db

# --- Lab VM host (docker processes + cpu/mem/disk) ---
# Auth is the same OFFICE_GATEWAY_TOKEN. Do not put a second VM password in Hermes.
OFFICE_HOST_ENABLED=1
OFFICE_DOCKER_SOCK=/var/run/docker.sock
OFFICE_HOST_CPU_CRITICAL=90
OFFICE_HOST_MEMORY_CRITICAL=90
OFFICE_HOST_DISK_CRITICAL=90

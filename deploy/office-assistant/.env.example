# Copy to .env and fill before `docker compose up -d --build`.
# Hermes image pinned to the reviewed v2026.8 release.
# WARNING: never use `:latest` for an air-gap deployment; mirror this exact tag.
HERMES_IMAGE=nousresearch/hermes-agent:v2026.8.3

# Compose build context for office-gateway.
# Repo checkout: ../..   Flattened Lab VM (/home/timai/hermes-assistant): .
OFFICE_GATEWAY_CONTEXT=../..

# Dashboard bind on Lab LAN (supervisor only).
HERMES_DASHBOARD_PUBLISH=10.216.4.80:9119

# Athena console overlay reads supervisor chat to drive the VTuber bubble.
HERMES_DASHBOARD_URL=http://hermes-agent:9119
HERMES_DASHBOARD_USERNAME=
HERMES_DASHBOARD_PASSWORD=

# Athena console: VTuber portrait + specialist wall + chat (nginx overlay).
# This is the HTTP front door on the Lab VM (port 80). Stop the old
# dashboard-proxy if it still binds :80. Raw Dashboard stays on :9119.
HERMES_CONSOLE_PUBLISH=10.216.4.80:80

# Docker socket group GID for office-gateway (runs as UID 10001).
# Replace 998 with your host value: Linux `stat -c %g /var/run/docker.sock`,
# macOS Docker Desktop `stat -f %g /var/run/docker.sock`.
DOCKER_GID=998

# --- office-gateway tokens (one per fleet role) ---
OFFICE_GATEWAY_TOKEN_SUPERVISOR=
OFFICE_GATEWAY_TOKEN_LAB_HOST=
OFFICE_GATEWAY_TOKEN_VECTOR=
OFFICE_GATEWAY_TOKEN_CLUSTER=
OFFICE_GATEWAY_TOKEN_LLM=
OFFICE_GATEWAY_TOKEN_OBS=

# Named health endpoints (comma-separated name=https://url).
# Example entries — replace hosts with your Lab / cluster addresses:
# OFFICE_SERVICE_URLS=grafana=https://grafana.lab/api/health,victoria=https://victoria.lab/health,prometheus=https://prometheus.lab/-/healthy,litellm=https://litellm.lab/health,milvus-dev=https://milvus-dev.lab/healthz,milvus-prod=https://milvus-prod.lab/healthz,minio=https://minio.lab/minio/health/live,qdrant=https://qdrant.lab/healthz,rancher=https://rancher.lab/healthz
OFFICE_SERVICE_URLS=

# Docker restart allowlists (gateway enforces per role).
# After first `docker compose up`, run `docker compose ps -a` and replace
# hermes-assistant-* container names below with the actual Compose names.
OFFICE_WRITE_LAB_HOST=aiplatform-dashboard,aiplatform-agent-inference,aiplatform-workflow,common-service-frontend,hermes-assistant-hermes-agent-1,hermes-assistant-office-gateway-1,hermes-assistant-dashboard-proxy-1
OFFICE_WRITE_VECTOR=milvus-standalone,attu
OFFICE_VECTOR_ENV=milvus-standalone:dev,attu:dev,milvus-prod:prod

# Grafana panel deep links (obs role).
OFFICE_GRAFANA_BASE_URL=
OFFICE_GRAFANA_DASHBOARDS=
OFFICE_GRAFANA_PANELS=

# VictoriaMetrics or Prometheus query base URL (obs role).
OFFICE_METRICS_URL=

# Expected MIG profile counts on the H200 node (cluster-gpu role).
OFFICE_MIG_EXPECTED=1g.18gb:7,2g.35gb:2,3g.71gb:2,4g.71gb:1,7g.141gb:1

# Host path mounted read-only into office-gateway for cluster-gpu k8s reads.
# Unset or ./kubeconfig.absent is fine; MIG reads then skip kubeconfig.
OFFICE_KUBECONFIG=./kubeconfig.absent

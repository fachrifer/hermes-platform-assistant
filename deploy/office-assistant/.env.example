# Copy to .env and fill before `docker compose up -d --build`.
# Hermes image pinned to the reviewed v2026.9.21 release.
# WARNING: never use `:latest` for an air-gap deployment; mirror this exact tag.
HERMES_IMAGE=nousresearch/hermes-agent:v2026.9.21

# Compose build context for office-gateway.
# Repo checkout: ../..   Flattened Lab VM (/home/timai/hermes-assistant): .
OFFICE_GATEWAY_CONTEXT=../..

# Dashboard bind on Lab LAN (supervisor only).
HERMES_DASHBOARD_PUBLISH=10.216.4.80:9119
# Athena dashboard.public_url / WS Origin. pair-env fills http://$HERMES_DASHBOARD_PUBLISH.
HERMES_DASHBOARD_PUBLIC_URL=

# Athena console overlay reads supervisor chat to drive the VTuber bubble.
HERMES_DASHBOARD_URL=http://hermes-agent:9119
HERMES_DASHBOARD_USERNAME=
HERMES_DASHBOARD_PASSWORD=
# v0.21.0 dashboard session HMAC (32+ bytes). Compose maps this into hermes-agent.
# Generate: openssl rand -base64 32
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
# Desktop Remote gateway: paste this as Session token. pair-env generates it.
# Use HTTP dashboard URL (no CA): http://10.216.4.80:9119
HERMES_DASHBOARD_SESSION_TOKEN=
# Browser path prefix for /bots/ (not Desktop WS).
HERMES_BOT_PUBLIC_ORIGIN=http://10.216.4.80
# Desktop specialist dashboards bind this IP (Athena-style IP:port).
# Lab: 10.216.4.80  Laptop local-up: 127.0.0.1
# Ports: lab-host 9121, vector 9122, cluster-gpu 9123, llm 9124, obs 9125, ingress 9126
HERMES_BOT_BIND=10.216.4.80

# Athena console: VTuber portrait + specialist wall + chat (nginx overlay).
# Overlay reads supervisor chat to drive the VTuber bubble. HTTP :80 still
# serves /bots/ for browsers; Desktop specialists use :9121–:9126.
HERMES_CONSOLE_PUBLISH=10.216.4.80:80
HERMES_CONSOLE_TLS_PUBLISH=10.216.4.80:443
# TLS: ./scripts/init-lab-ca.sh once, then ./scripts/issue-edge-cert.sh
# (90-day leaf, SAN IP 10.216.4.80 + 127.0.0.1). CA key stays in ./ca (host).
# Import ./ca/ca.crt into client OS/browser trust stores once.
# Edge HTTP paths: edit edge-routes then python3 scripts/render-edge-nginx.py
# Leaf cert is also mounted read-only into office-gateway so Janus can report
# expiry via GET /v1/edge/tls (compose default OFFICE_EDGE_TLS_CERT_PATH=/certs/tls.crt).
# OFFICE_EDGE_TLS_CERT_PATH=/certs/tls.crt

# Docker socket group GID for office-gateway (runs as UID 10001).
# Replace 998 with your host value: Linux `stat -c %g /var/run/docker.sock`,
# macOS Docker Desktop `stat -f %g /var/run/docker.sock`.
DOCKER_GID=998

# --- office-gateway tokens (one per fleet role) ---
OFFICE_GATEWAY_TOKEN_SUPERVISOR=
OFFICE_GATEWAY_TOKEN_LAB_HOST=
OFFICE_GATEWAY_TOKEN_INGRESS=
OFFICE_GATEWAY_TOKEN_LLM=
OFFICE_GATEWAY_TOKEN_CLUSTER=
OFFICE_GATEWAY_TOKEN_VECTOR=
OFFICE_GATEWAY_TOKEN_OBS=
# Used only by the approvals console (Traefik injects it); never give it to an agent.
OFFICE_GATEWAY_TOKEN_APPROVER=

# Base URL of the approvals console; propose_* tools answer with <url>/approvals/.
OFFICE_CONSOLE_URL=https://10.216.4.80

# Vector health probes (comma-separated name=url). Empty uses the built-in
# milvus-dev, milvus-prod (10.216.203.132:9091) and qdrant-dev defaults.
OFFICE_VECTOR_INSTANCES=

# Edge-routes backups (newest 10 kept). Empty = <edge-routes dir>/backups.
OFFICE_EDGE_BACKUP_DIR=

# Named health endpoints (comma-separated name=https://url).
# Example entries — replace hosts with your Lab / cluster addresses:
# OFFICE_SERVICE_URLS=grafana=https://grafana.lab/api/health,victoria=https://victoria.lab/health,prometheus=https://prometheus.lab/-/healthy,litellm=https://litellm.lab/health,milvus-dev=https://milvus-dev.lab/healthz,milvus-prod=https://milvus-prod.lab/healthz,minio=https://minio.lab/minio/health/live,qdrant=https://qdrant.lab/healthz,rancher=https://rancher.lab/healthz
OFFICE_SERVICE_URLS=

# Grafana panel deep links (obs role).
OFFICE_GRAFANA_BASE_URL=
OFFICE_GRAFANA_TOKEN=
OFFICE_GRAFANA_FOLDER_UID=
OFFICE_GRAFANA_DATASOURCE_UID=
OFFICE_GRAFANA_DASHBOARDS=
OFFICE_GRAFANA_PANELS=

# VictoriaMetrics or Prometheus query base URL (obs role).
OFFICE_METRICS_URL=

# LiteLLM proxy root (with or without /v1). office-gateway uses the master key
# for the llm role's read-only status tools. Never put this key in hermes/*/.env.
# LITELLM_URL / LITELLM_MASTER_KEY aliases are also accepted.
OFFICE_LITELLM_URL=
OFFICE_LITELLM_MASTER_KEY=

# Expected MIG profile counts on the H200 node (cluster-gpu role).
OFFICE_MIG_EXPECTED=1g.18gb:7,2g.35gb:2,3g.71gb:2,4g.71gb:1,7g.141gb:1

# Host path mounted read-only into office-gateway for cluster-gpu k8s reads.
# Unset or ./kubeconfig.absent is fine; MIG reads then skip kubeconfig.
OFFICE_KUBECONFIG=./kubeconfig.absent

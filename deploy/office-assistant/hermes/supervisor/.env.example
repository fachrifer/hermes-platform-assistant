# Copy to .env and fill. Supervisor (Athena) secrets only.
# Gateway bearer for the supervisor role (pair-env copies it from the root .env).
OFFICE_GATEWAY_TOKEN=
# LiteLLM virtual key for the supervisor. Base URL lives in models.env.
OFFICE_LLM_API_KEY=
# Key other clients use to call this agent's API server.
API_SERVER_KEY=

# Required because the dashboard binds to 0.0.0.0.
HERMES_DASHBOARD_USERNAME=
HERMES_DASHBOARD_PASSWORD=
# Stable session HMAC (32+ bytes). Blank means signed-out on every restart.
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
# Same token as the root .env: Desktop session token (pair-env copies it).
HERMES_DASHBOARD_SESSION_TOKEN=

# Bot peer keys: each equals that specialist's API_SERVER_KEY (pair-env copies them).
HERMES_PEER_PEER_LAB_HOST_KEY=
HERMES_PEER_PEER_INGRESS_KEY=
HERMES_PEER_PEER_LLM_KEY=
HERMES_PEER_PEER_CLUSTER_GPU_KEY=
HERMES_PEER_PEER_VECTOR_KEY=
HERMES_PEER_PEER_OBS_KEY=

# Copy to .env and fill. Keep this file scoped to supervisor secrets only.
OFFICE_GATEWAY_TOKEN=

# Outbound bearer tokens must match each specialist's A2A_BEARER_TOKEN.
A2A_TOKEN_LAB_HOST=
A2A_TOKEN_VECTOR=
A2A_TOKEN_CLUSTER_GPU=
A2A_TOKEN_LLM_EDGE=
A2A_TOKEN_OBS=
A2A_TOKEN_EDGE=

# Shared LiteLLM endpoint; use a supervisor-scoped key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://litellm.lab/v1
OPENAI_MODEL=

# Required because the dashboard binds to 0.0.0.0.
# v0.21.0 also reads HERMES_DASHBOARD_BASIC_AUTH_* (compose aliases USERNAME/PASSWORD).
HERMES_DASHBOARD_USERNAME=
HERMES_DASHBOARD_PASSWORD=
# Stable session HMAC (32+ bytes). Blank → signed-out on every container restart.
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
# Same token as root .env — Desktop Session token (pair-env copies it).
HERMES_DASHBOARD_SESSION_TOKEN=
# Desktop /api/ws Origin allowlist. pair-env sets http://$HERMES_DASHBOARD_PUBLISH.
HERMES_DASHBOARD_PUBLIC_URL=
# hermes peer keys — must match each specialist API_SERVER_KEY (pair-env copies them).
HERMES_PEER_LAB_HOST_KEY=
HERMES_PEER_VECTOR_KEY=
HERMES_PEER_CLUSTER_GPU_KEY=
HERMES_PEER_LLM_EDGE_KEY=
HERMES_PEER_OBS_KEY=
HERMES_PEER_EDGE_KEY=

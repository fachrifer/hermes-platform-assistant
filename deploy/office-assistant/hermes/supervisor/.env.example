# Copy to .env and fill. Keep this file scoped to supervisor secrets only.
OFFICE_GATEWAY_TOKEN=

# Outbound bearer tokens must match each specialist's A2A_BEARER_TOKEN.
A2A_TOKEN_LAB_HOST=
A2A_TOKEN_VECTOR=
A2A_TOKEN_CLUSTER_GPU=
A2A_TOKEN_LLM_EDGE=
A2A_TOKEN_OBS=

# Shared LiteLLM endpoint; use a supervisor-scoped key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://litellm.lab/v1
OPENAI_MODEL=

# Required because the dashboard binds to 0.0.0.0.
HERMES_DASHBOARD_USERNAME=
HERMES_DASHBOARD_PASSWORD=

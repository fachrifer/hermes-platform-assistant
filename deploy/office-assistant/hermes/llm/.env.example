# Copy to .env and fill with llm-scoped credentials only.
# Gateway bearer for the llm role (pair-env copies it from the root .env).
OFFICE_GATEWAY_TOKEN=
# LiteLLM virtual key for llm. Base URL lives in models.env.
OFFICE_LLM_API_KEY=
# Athena calls this agent with this key (pair-env copies it to the supervisor).
API_SERVER_KEY=
# Same token as the root .env (pair-env copies it).
HERMES_DASHBOARD_SESSION_TOKEN=

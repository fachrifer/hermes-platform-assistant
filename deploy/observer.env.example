# Runs on the always-on intranet monitoring server.
OFFICE_OBSERVER_ID=office-observer-1
OFFICE_OBSERVER_SHARED_SECRET=
OFFICE_OBSERVER_SPOOL_PATH=/var/lib/hermes-observer/observer.db
OFFICE_OBSERVER_INTERVAL_SECONDS=300

# Fixed health endpoints only. Do not include query strings, credentials, or paths to user content.
OFFICE_SERVICE_URLS=kubernetes=https://kubernetes.office.local/readyz,rancher=https://rancher.office.local/ping,prometheus=https://prometheus.office.local/-/ready,victoriametrics=https://victoriametrics.office.local/health,grafana=https://grafana.office.local/api/health,openwebui=https://openwebui.office.local/health,vector-db=https://vector-db.office.local/health,litellm=https://litellm.office.local/health

# Mutual TLS to the laptop relay. Store private keys in OFFICE_OBSERVER_CERT_DIR.
OFFICE_RELAY_URL=https://laptop-relay.office.local:8443
OFFICE_RELAY_CA_FILE=/certs/relay-ca.pem
OFFICE_RELAY_CLIENT_CERT=/certs/observer-client.pem
OFFICE_RELAY_CLIENT_KEY=/certs/observer-client-key.pem

# Host-only paths used by docker-compose.observer.yml
OFFICE_OBSERVER_STATE_DIR=/opt/hermes-office-observer/state
OFFICE_OBSERVER_CERT_DIR=/opt/hermes-office-observer/certs
